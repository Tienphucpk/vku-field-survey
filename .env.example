# ==============================================
# VKU Field Survey - Environment Configuration
# ==============================================
# Copy file này thành .env và cấu hình theo môi trường:
#   cp .env.example .env
#
# Vite sẽ tự động load file .env khi chạy dev/build.
# Chỉ biến có prefix VITE_ mới được expose cho client-side code.
# ==============================================

# API Server Base URL
# -------------------
# Đặt URL server backend để Sync Queue gửi dữ liệu khảo sát.
#
# Ví dụ:
#   VITE_API_BASE_URL=https://api.vku-survey.example.com
#   VITE_API_BASE_URL=https://your-backend.workers.dev
#   VITE_API_BASE_URL=http://localhost:8787
#
# Nếu để trống hoặc không đặt:
#   → App chạy chế độ MOCK (mô phỏng)
#   → Sync Queue vẫn hoạt động nhưng dữ liệu không gửi server thật
#   → Trạng thái SYNCED chỉ là mô phỏng cho mục đích phát triển/demo
#
VITE_API_BASE_URL=
